# ── Google Maps ──────────────────────────────────────────────
# Backend key (Places API, Directions API)
GOOGLE_MAPS_API_KEY=YOUR_GOOGLE_MAPS_API_KEY_HERE
# Frontend key (Maps JavaScript API) — must start with VITE_
VITE_GOOGLE_MAPS_API_KEY=YOUR_VITE_GOOGLE_MAPS_API_KEY_HERE

# ── Twilio (optional — SMS verification) ─────────────────────
TWILIO_ACCOUNT_SID=YOUR_TWILIO_SID_HERE
TWILIO_AUTH_TOKEN=YOUR_TWILIO_TOKEN_HERE
TWILIO_PHONE_NUMBER=YOUR_TWILIO_PHONE_NUMBER_HERE

# ── Session ───────────────────────────────────────────────────
# Use a long random string in production (e.g. openssl rand -hex 32)
SESSION_SECRET=YOUR_SESSION_SECRET_HERE

# ── Server ────────────────────────────────────────────────────
PORT=3001

# ── Production (set automatically by Railway) ────────────────
# NODE_ENV=production
